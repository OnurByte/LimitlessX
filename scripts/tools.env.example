# wasm-bindgen CLI must match Cargo.lock. Binaryen is pinned for release builds.
# Install Rust using rustup, then:
# rustup show
# cargo install wasm-bindgen-cli --version 0.2.129 --locked
# Download Binaryen version_133 from https://github.com/WebAssembly/binaryen/releases/tag/version_133
# export WASM_OPT=/absolute/path/binaryen-version_133/bin/wasm-opt
