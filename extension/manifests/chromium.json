{
  "manifest_version": 3,
  "name": "LimitlessX",
  "version": "0.1.0",
  "description": "View public X content through an alternative source, when available.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://api.fxtwitter.com/*"
  ],
  "background": {
    "service_worker": "adapters/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "LimitlessX",
    "default_icon": {
      "16": "brand/icon-16.png",
      "32": "brand/icon-32.png",
      "48": "brand/icon-48.png",
      "128": "brand/icon-128.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'none'; base-uri 'none'; connect-src 'self' https://api.fxtwitter.com; img-src 'self' https://pbs.twimg.com; media-src https://video.twimg.com; style-src 'self'; frame-src 'none'"
  },
  "icons": {
    "16": "brand/icon-16.png",
    "32": "brand/icon-32.png",
    "48": "brand/icon-48.png",
    "128": "brand/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://www.x.com/*",
        "https://twitter.com/*",
        "https://www.twitter.com/*"
      ],
      "js": [
        "adapters/content.js"
      ],
      "css": [
        "styles/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "styles/app.css"
      ],
      "matches": [
        "https://x.com/*",
        "https://www.x.com/*",
        "https://twitter.com/*",
        "https://www.twitter.com/*"
      ]
    }
  ]
}
